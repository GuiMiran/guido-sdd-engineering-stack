{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GUIDO SDD — Checkout module test data. All prices verified against live SauceDemo on 2026-04-20.",

  "customers": {
    "valid_customer": {
      "firstName": "Jane",
      "lastName": "Doe",
      "zipCode": "12345"
    },
    "missing_first_name": {
      "firstName": "",
      "lastName": "Doe",
      "zipCode": "12345",
      "expectedError": "Error: First Name is required",
      "expectedErrorContains": "First Name is required"
    },
    "missing_last_name": {
      "firstName": "Jane",
      "lastName": "",
      "zipCode": "12345",
      "expectedError": "Error: Last Name is required",
      "expectedErrorContains": "Last Name is required"
    },
    "missing_zip": {
      "firstName": "Jane",
      "lastName": "Doe",
      "zipCode": "",
      "expectedError": "Error: Postal Code is required",
      "expectedErrorContains": "Postal Code is required"
    }
  },

  "cart_scenarios": {
    "checkout_single": {
      "products": ["Sauce Labs Backpack"],
      "expectedItemCount": 1,
      "items": [
        {
          "name": "Sauce Labs Backpack",
          "quantity": 1,
          "unitPrice": 29.99,
          "priceFormatted": "$29.99"
        }
      ],
      "summary": {
        "subtotal": 29.99,
        "subtotalFormatted": "$29.99",
        "tax": 2.40,
        "taxFormatted": "$2.40",
        "total": 32.39,
        "totalFormatted": "$32.39"
      },
      "$comment": "Tax rate ~8.0125% on $29.99 = $2.40 (rounded). Total = $32.39."
    },
    "checkout_multi": {
      "products": [
        "Sauce Labs Backpack",
        "Sauce Labs Bike Light",
        "Sauce Labs Bolt T-Shirt"
      ],
      "expectedItemCount": 3,
      "items": [
        {
          "name": "Sauce Labs Backpack",
          "quantity": 1,
          "unitPrice": 29.99,
          "priceFormatted": "$29.99"
        },
        {
          "name": "Sauce Labs Bike Light",
          "quantity": 1,
          "unitPrice": 9.99,
          "priceFormatted": "$9.99"
        },
        {
          "name": "Sauce Labs Bolt T-Shirt",
          "quantity": 1,
          "unitPrice": 15.99,
          "priceFormatted": "$15.99"
        }
      ],
      "summary": {
        "subtotal": 55.97,
        "subtotalFormatted": "$55.97",
        "tax": 4.48,
        "taxFormatted": "$4.48",
        "total": 60.45,
        "totalFormatted": "$60.45"
      },
      "$comment": "29.99 + 9.99 + 15.99 = 55.97. Tax ~8.0125% = 4.48. Total = 60.45."
    }
  },

  "confirmation": {
    "expectedHeader": "Thank you for your order!",
    "expectedHeaderSelector": ".complete-header",
    "expectedUrl": "/checkout-complete.html"
  },

  "urls": {
    "cart": "/cart.html",
    "checkoutStep1": "/checkout-step-one.html",
    "checkoutStep2": "/checkout-step-two.html",
    "checkoutComplete": "/checkout-complete.html",
    "inventory": "/inventory.html"
  },

  "timeouts": {
    "defaultSeconds": 5,
    "formSubmitSeconds": 5
  }
}
